<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="lunabotics_rover">
    <self_collide>false</self_collide>
    <link name="base_link">
      <pose>0 0 0.43 0 0 0</pose>
      <inertial>
        <mass>55.0</mass>
        <inertia><ixx>5.0</ixx><iyy>7.0</iyy><izz>8.0</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>1.15 0.72 0.24</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><box><size>1.15 0.72 0.24</size></box></geometry>
        <material><diffuse>0.95 0.45 0.03 1</diffuse></material>
      </visual>
      <visual name="upper_frame">
        <pose>0 0 0.39 0 0 0</pose>
        <geometry><box><size>0.85 0.58 0.08</size></box></geometry>
        <material><diffuse>0.95 0.45 0.03 1</diffuse></material>
      </visual>
    </link>

    <!-- The exported wheel mesh has its axle on local Y.  Keep the mesh link
         unrotated; only rotate the simple physics cylinder from Z onto Y. -->
    <link name="front_left_wheel"><pose>0.43 0.44 0.25 0 0 0</pose><inertial><mass>8.93632</mass><inertia><ixx>0.0797664</ixx><iyy>0.146428</iyy><izz>0.0797664</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.16</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision><visual name="visual"><pose>0 0.027 0 0 0 0</pose><geometry><mesh><uri>model://lunabotics_rover/meshes/wheel.stl</uri></mesh></geometry></visual></link>
    <link name="front_right_wheel"><pose>0.43 -0.44 0.25 0 0 0</pose><inertial><mass>8.93632</mass><inertia><ixx>0.0797664</ixx><iyy>0.146428</iyy><izz>0.0797664</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.16</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision><visual name="visual"><pose>0 0.027 0 0 0 0</pose><geometry><mesh><uri>model://lunabotics_rover/meshes/wheel_Mirrored.stl</uri></mesh></geometry></visual></link>
    <link name="rear_left_wheel"><pose>-0.43 0.44 0.25 0 0 0</pose><inertial><mass>8.93632</mass><inertia><ixx>0.0797664</ixx><iyy>0.146428</iyy><izz>0.0797664</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.16</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision><visual name="visual"><pose>0 0.027 0 0 0 0</pose><geometry><mesh><uri>model://lunabotics_rover/meshes/wheel.stl</uri></mesh></geometry></visual></link>
    <link name="rear_right_wheel"><pose>-0.43 -0.44 0.25 0 0 0</pose><inertial><mass>8.93632</mass><inertia><ixx>0.0797664</ixx><iyy>0.146428</iyy><izz>0.0797664</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.16</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision><visual name="visual"><pose>0 0.027 0 0 0 0</pose><geometry><mesh><uri>model://lunabotics_rover/meshes/wheel_Mirrored.stl</uri></mesh></geometry></visual></link>

    <joint name="front_left_wheel_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>80</effort><velocity>25</velocity></limit></axis></joint>
    <joint name="front_right_wheel_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>80</effort><velocity>25</velocity></limit></axis></joint>
    <joint name="rear_left_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>80</effort><velocity>25</velocity></limit></axis></joint>
    <joint name="rear_right_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>80</effort><velocity>25</velocity></limit></axis></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint><left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint><right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.88</wheel_separation><wheel_radius>0.25</wheel_radius>
      <topic>cmd_vel</topic><odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
    </plugin>
  </model>
</sdf>
