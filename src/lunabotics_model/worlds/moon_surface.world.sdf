<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="lunabotics_moon_surface">
    <gravity>0 0 -1.622</gravity>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.16 0.16 0.18 1</ambient>
      <background>0.01 0.015 0.03 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1 0.96 0.88 1</diffuse>
      <specular>0.08 0.08 0.08 1</specular>
      <direction>-0.45 0.25 -0.86</direction>
    </light>

    <include><uri>model://lunar_heightmap</uri></include>
    <!-- The DEM is about z=0 at its center; start the rover safely above it. -->
    <include><uri>model://lunabotics_rover</uri><pose>0 0 0.6 0 0 0</pose></include>
  </world>
</sdf>
